{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "sources": {
      "type": "array",
      "description": "Array of source configurations",
      "items": {
        "type": "object",
        "required": ["id", "name", "links"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{10,}$",
            "description": "Unique source identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Source name"
          },
          "domain": {
            "type": "string",
            "description": "Source domain"
          },
          "category": {
            "type": "string",
            "enum": ["main", "backup", "experimental"],
            "default": "main",
            "description": "Source category"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "links": {
            "type": "array",
            "maxItems": 30,
            "description": "List of stream links",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Stream URL"
                },
                "status": {
                  "type": "string",
                  "enum": ["active", "inactive", "testing"],
                  "default": "active",
                  "description": "Link status"
                },
                "addedAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When link was added"
                },
                "healthCheck": {
                  "type": "object",
                  "description": "Last health check result",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    },
                    "checkedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "description": "Source tags",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string",
            "description": "Additional notes"
          }
        }
      }
    }
  }
}
